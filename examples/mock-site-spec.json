{
  "spec_version": "1.0",
  "title_ko": "Chickadee Bot 모의 광고 삽입 웹 제작 명세",
  "sample_origin": "synthetic",
  "purpose_ko": "침해 후 광고가 삽입된 DOM 상태를 재현하는 테스트 웹. 실제 취약점이나 공격 코드는 구현할 필요가 없다.",
  "execution": {
    "bind_host": "127.0.0.1",
    "suggested_port": 8765,
    "external_requests": false,
    "external_ad_links": false,
    "real_credentials": false,
    "resources": "local_only",
    "notes_ko": "PC 보호를 위해 외부 스크립트·광고 이미지·추적 코드 없이 자체 제작 자원만 사용한다."
  },
