{
  "name": "chickadee-desktop",
  "version": "0.6.2",
  "description": "Chickadee visual website inspection workspace",
  "author": "Chickadee contributors",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node tests/smoke.cjs",
    "format": "prettier --write src electron tests *.mjs *.html package.json"
  },
  "devDependencies": {
    "@xyflow/react": "12.12.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "lucide-react": "1.60.0",
    "playwright": "1.64.0",
    "pretendard": "1.3.9",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.chickadee.inspector",
    "productName": "Chickadee",
    "directories": {
      "output": "../artifacts/electron-0.6.2"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/app.ico",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "../artifacts/engine-0.6.2/ChickadeeEngine",
        "to": "engine"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": true,
      "icon": "assets/app.ico"
    },
    "asar": true
  }
}
